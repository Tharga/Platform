@page "/team"
@rendermode InteractiveServer
@attribute [Authorize]
@using Microsoft.AspNetCore.Authorization

<PageTitle>Team Management</PageTitle>

<RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Gap="1.5rem" class="rz-mb-3">
    <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Gap="0.5rem">
        <RadzenSwitch @bind-Value="_showScopeTooltip" /> <RadzenLabel Text="Show scope tooltip" />
    </RadzenStack>
    <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Gap="0.5rem">
        <RadzenSwitch @bind-Value="_showScopeOverrides" /> <RadzenLabel Text="Show scope overrides" />
    </RadzenStack>
    <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Gap="0.5rem">
        <RadzenSwitch @bind-Value="_showRoles" /> <RadzenLabel Text="Show roles" />
    </RadzenStack>
</RadzenStack>

@* ShowAuditLogButton is on because the sample configures MongoDB audit storage; the per-member action
   still hides itself for anyone without audit:read. *@
@* TeamFilterThreshold lowered to match the selector in NavMenu, so the grid layout and its filter are
   reachable in a sample that rarely has eight teams. Both default to 8; a real host should leave them. *@
<TeamComponent TMember="Tharga.Team.Sample.Framework.Team.TeamMember" EnableMemberNameEdit="true"
               TeamFilterThreshold="2"
               ShowAuditLogButton="true"
               ShowScopeTooltip="_showScopeTooltip" ShowScopeOverrides="_showScopeOverrides" ShowRoles="_showRoles" />

@code {
    private bool _showScopeTooltip = true;
    private bool _showScopeOverrides;
    private bool _showRoles;
}
