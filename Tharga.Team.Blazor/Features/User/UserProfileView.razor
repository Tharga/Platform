@using System.Text.Json
@using Microsoft.Extensions.DependencyInjection
@using Microsoft.JSInterop
@using Tharga.Team
@using Tharga.Toolkit
@inject IJSRuntime JS
@inject IUserService UserService
@inject IServiceProvider ServiceProvider
@inject IconSettings IconSettings
@inject DialogService DialogService

<CascadingAuthenticationState>
    <AuthorizeView>
        <Authorized>
            <RadzenStack Orientation="Orientation.Vertical" Gap="1rem">
                <RadzenCard>
                    <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Gap="1rem">
                        <UserAvatar User="_user" Size="64px" />
                        <RadzenStack Gap="0.25rem">
                            @if (_editingName)
                            {
                                <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Gap="0.25rem">
                                    <RadzenTextBox Value="@_editedName" ValueChanged="@(v => _editedName = v)" Placeholder="Your name" />
                                    <RadzenButton Icon="check" ButtonStyle="ButtonStyle.Success" Variant="Variant.Flat" Size="ButtonSize.Small"
                                                  Click="SaveName" title="Save" />
                                    <RadzenButton Icon="close" ButtonStyle="ButtonStyle.Light" Variant="Variant.Flat" Size="ButtonSize.Small"
                                                  Click="@(() => _editingName = false)" title="Cancel" />
                                </RadzenStack>
                            }
                            else
                            {
                                <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Gap="0.25rem">
                                    <RadzenText TextStyle="TextStyle.Subtitle1" class="rz-m-0"><strong>@(_user?.Name ?? context.User.GetEmail())</strong></RadzenText>
                                    <RadzenButton Icon="edit" Variant="Variant.Text" Size="ButtonSize.Small"
                                                  Click="StartNameEdit" title="Edit your name" />
                                </RadzenStack>
                            }
                            <RadzenText TextStyle="TextStyle.Caption">@(_user?.EMail ?? context.User.GetEmail())</RadzenText>
                            @if (_canUpload)
                            {
                                <RadzenButton Text="Change picture" Icon="photo_camera" ButtonStyle="ButtonStyle.Light" Size="ButtonSize.Small" Click="ChangePicture" />
                            }
                            @if (!string.IsNullOrEmpty(_user?.Icon))
                            {
                                <RadzenText TextStyle="TextStyle.Caption">Using your uploaded picture.</RadzenText>
                            }
                            else if (IconSettings.GravatarEnabled)
                            {
                                <RadzenText TextStyle="TextStyle.Caption">
                                    Your picture comes from <RadzenLink Path="https://gravatar.com/" Target="gravatar">Gravatar</RadzenLink> (based on your email).@(_canUpload ? " Upload your own with “Change picture” above, or manage it at Gravatar." : " Register your email at Gravatar to change it.")
                                </RadzenText>
                            }
                        </RadzenStack>
                    </RadzenStack>
                </RadzenCard>
                <ExpandableCard Icon="work" Text="Claims">
                    <ChildContent>
                        <RadzenStack Orientation="Orientation.Horizontal" JustifyContent="JustifyContent.End" class="rz-mb-2">
                            <RadzenButton Icon="content_copy" Text="Copy as JSON" ButtonStyle="ButtonStyle.Light" Size="ButtonSize.Small"
                                          Click="@(() => CopyClaimsAsync(context.User))" />
                        </RadzenStack>
                        <ul style="word-break: break-all; overflow-wrap: break-word;">
                            @foreach (var claim in context.User.Claims)
                            {
                                <li><strong>@claim.Type:</strong> @claim.Value</li>
                            }
                        </ul>
                    </ChildContent>
                </ExpandableCard>
            </RadzenStack>
        </Authorized>
        <NotAuthorized>
            <RadzenText>Not authorized</RadzenText>
        </NotAuthorized>
    </AuthorizeView>
</CascadingAuthenticationState>

@code {
    private IUser _user;
    private bool _canUpload;
    private bool _editingName;
    private string _editedName;

    protected override async Task OnInitializedAsync()
    {
        _user = await UserService.GetCurrentUserAsync();
        _canUpload = IconSettings.AllowUserUpload && ServiceProvider.GetService<IIconStore>() != null;
    }

    private void StartNameEdit()
    {
        _editedName = _user?.Name;
        _editingName = true;
    }

    /// <summary>
    /// Writes the caller's own <see cref="IUser.Name"/> — the root name, shared across every team.
    /// Per-team display names are overrides set by a team administrator and are untouched here.
    /// </summary>
    private async Task SaveName()
    {
        var trimmed = string.IsNullOrWhiteSpace(_editedName) ? null : _editedName.Trim();
        if (trimmed == _user?.Name)
        {
            _editingName = false;
            return;
        }

        await UserService.SetUserNameAsync(_user.Key, trimmed);
        _user = await UserService.GetCurrentUserAsync();
        _editingName = false;
    }

    private async Task ChangePicture()
    {
        var result = await DialogService.OpenAsync<UserIconDialog>("Profile picture",
            new Dictionary<string, object> { { nameof(UserIconDialog.HasIcon), !string.IsNullOrEmpty(_user?.Icon) } },
            new DialogOptions { Width = "480px" });

        if (result is true)
        {
            _user = await UserService.GetCurrentUserAsync();
            StateHasChanged();
        }
    }

    private async Task CopyClaimsAsync(System.Security.Claims.ClaimsPrincipal principal)
    {
        var data = new
        {
            IdentityName = principal.Identity?.Name,
            AuthenticationType = principal.Identity?.AuthenticationType,
            Claims = principal.Claims.Select(c => new { c.Type, c.Value }).ToArray()
        };
        var json = JsonSerializer.Serialize(data, new JsonSerializerOptions { WriteIndented = true });
        await JS.InvokeVoidAsync("navigator.clipboard.writeText", json);
    }
}
