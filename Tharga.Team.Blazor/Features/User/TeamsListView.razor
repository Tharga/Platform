@using Tharga.Team
@using Microsoft.AspNetCore.Components.Authorization
@using Tharga.Team.Blazor.Features.Team
@typeparam TMember where TMember : class, Tharga.Team.ITeamMember
@inject ITeamService TeamService
@inject IUserService UserService
@inject AuthenticationStateProvider AuthenticationStateProvider
@inject DialogService DialogService
@inject NotificationService NotificationService
@inject Microsoft.Extensions.Options.IOptions<Tharga.Team.Blazor.Framework.ThargaBlazorOptions> BlazorOptions

@if (!_canAdminister)
{
    <RadzenAlert AlertStyle="AlertStyle.Warning" ShowIcon="true" Variant="Variant.Flat" AllowClose="false" class="rz-mt-2">
        Viewing teams and their members requires the <b>@SystemUserScopes.Manage</b> system scope.
    </RadzenAlert>
}
else if (_loaded)
{
    <RadzenDataGrid Data="@_teamViewModels" TItem="TeamViewModel" AllowSorting="true" AllowPaging="true" PageSize="10"
                    AllowFiltering="true" FilterMode="FilterMode.Simple" FilterCaseSensitivity="FilterCaseSensitivity.CaseInsensitive">
        <Columns>
            <RadzenDataGridColumn Title="Name" Property="Name" />
            <RadzenDataGridColumn Title="Members" Property="MemberCount" Width="100px" Filterable="false" />
            @if (_canSeeAllTeams)
            {
                <RadzenDataGridColumn Title="Consent" Property="Consent" Width="140px" Filterable="false">
                    <Template Context="team">
                        <RadzenBadge BadgeStyle="@(Enum.Parse<BadgeStyle>(TeamVisibility.BadgeStyle(team.Consent)))"
                                     Variant="Variant.Flat"
                                     Text="@TeamVisibility.Label(team.Consent)" />
                    </Template>
                </RadzenDataGridColumn>
            }
            <RadzenDataGridColumn Title="" Width="200px" Sortable="false" Filterable="false">
                <Template>
                    <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Gap="1rem">
                        <RadzenButton Text="View" Icon="visibility" ButtonStyle="ButtonStyle.Light" Size="ButtonSize.Small"
                                      Click="@(() => ToggleDetails(context))" />
                        @if (_canDeleteTeams)
                        {
                            <RadzenButton Text="Delete" Icon="delete" ButtonStyle="ButtonStyle.Danger" Size="ButtonSize.Small"
                                          Click="@(() => DeleteTeamAsync(context))" />
                        }
                        @if (TeamActionsTemplate != null)
                        {
                            @TeamActionsTemplate(context)
                        }
                    </RadzenStack>
                </Template>
            </RadzenDataGridColumn>
        </Columns>
    </RadzenDataGrid>

    @if (_selectedTeam != null)
    {
        <RadzenCard class="rz-mt-3">
            <RadzenText TextStyle="TextStyle.Subtitle1"><strong>@_selectedTeam.Name</strong></RadzenText>
            <RadzenText TextStyle="TextStyle.Subtitle2" class="rz-mb-1">Members</RadzenText>
            <RadzenDataGrid Data="@_selectedTeam.Members" TItem="TeamMemberInfo" AllowSorting="true"
                            AllowFiltering="true" FilterMode="FilterMode.Simple" FilterCaseSensitivity="FilterCaseSensitivity.CaseInsensitive">
                <Columns>
                    <RadzenDataGridColumn Title="" Width="66px" Sortable="false" Filterable="false">
                        <Template>
                            <UserAvatar EMail="@context.EMail" IconReference="@context.Icon" Name="@context.Name" UserKey="@context.Key" Size="32px" />
                        </Template>
                    </RadzenDataGridColumn>
                    <RadzenDataGridColumn Title="Name" Property="Name" />
                    <RadzenDataGridColumn Title="Email" Property="EMail" />
                    <RadzenDataGridColumn Title="Role" Property="AccessLevel" Width="120px" Filterable="false" />
                    <RadzenDataGridColumn Title="State" Property="State" Width="100px" Filterable="false" />
                    <RadzenDataGridColumn Title="Last seen" Property="@nameof(TeamMemberInfo.LastSeen)" Width="150px" Filterable="false">
                        <Template>
                            <DateTimeView Date="@context.LastSeen" />
                        </Template>
                    </RadzenDataGridColumn>
                    @if (MemberActionsTemplate != null)
                    {
                        <RadzenDataGridColumn Title="" Sortable="false" Filterable="false">
                            <Template>
                                @MemberActionsTemplate(context)
                            </Template>
                        </RadzenDataGridColumn>
                    }
                </Columns>
            </RadzenDataGrid>
        </RadzenCard>
    }
}
else
{
    <Loading />
}

@code {
    /// <summary>
    /// Optional template rendered after the built-in View button in each team row's action column.
    /// </summary>
    [Parameter] public RenderFragment<TeamViewModel> TeamActionsTemplate { get; set; }

    /// <summary>
    /// Optional template rendered as an extra column at the right of each member row in the drill-down grid.
    /// </summary>
    [Parameter] public RenderFragment<TeamMemberInfo> MemberActionsTemplate { get; set; }

    private bool _loaded;
    private bool _canAdminister = true;
    private bool _canDeleteTeams;
    private IUser[] _users;
    private ITeam<TMember>[] _teams;
    private bool _canSeeAllTeams;

    private List<TeamViewModel> _teamViewModels = new();
    private TeamViewModel _selectedTeam;

    protected override async Task OnInitializedAsync()
    {
        var authState = await AuthenticationStateProvider.GetAuthenticationStateAsync();
        _canSeeAllTeams = TeamVisibility.CanSeeAllTeams(authState.User);
        _canAdminister = UserAdminGate.CanAdministerUsers(
            TeamScopeGate.HasSystemScope(authState.User, SystemUserScopes.Manage));
        _canDeleteTeams = UserAdminGate.CanDeleteTeams(
            TeamScopeGate.HasSystemScope(authState.User, SystemTeamScopes.Delete));

        if (_canAdminister)
        {
            await LoadDataAsync();
            _loaded = true;
        }

        await base.OnInitializedAsync();
    }

    private async Task LoadDataAsync()
    {
        _users = await UserService.GetAsync().ToArrayAsync();
        _teams = _canSeeAllTeams
            ? await TeamService.GetAllTeamsAsync<TMember>().ToArrayAsync()
            : await TeamService.GetTeamsAsync<TMember>().ToArrayAsync();

        BuildViewModels();
    }

    private void BuildViewModels()
    {
        _teamViewModels = _teams.Select(t => new TeamViewModel
        {
            Key = t.Key,
            Name = t.Name,
            MemberCount = t.Members?.Length ?? 0,
            Consent = TeamVisibility.Resolve(t.ConsentedRoles, t.ConsentAccessLevel, BlazorOptions.Value.Consent.AccessLevel),
            Members = (t.Members ?? []).Select(m =>
            {
                var user = _users.FirstOrDefault(u => u.Key == m.Key);
                return new TeamMemberInfo
                {
                    Key = m.Key,
                    Name = m.Name ?? user?.Name ?? TeamServiceBase.ResolveDisplayName(user),
                    EMail = user?.EMail ?? m.Invitation?.EMail,
                    Icon = user?.Icon,
                    AccessLevel = m.AccessLevel,
                    State = m.State,
                    LastSeen = m.LastSeen
                };
            }).ToArray()
        }).OrderBy(t => t.Name).ToList();
    }

    private void ToggleDetails(TeamViewModel team)
    {
        _selectedTeam = _selectedTeam?.Key == team.Key ? null : team;
    }

    /// <summary>
    /// Cross-team delete, authorized by the <see cref="SystemTeamScopes.Delete"/> system scope rather than
    /// by membership or consent. The service layer enforces the same rule, so this only avoids offering an
    /// action the server would refuse.
    /// </summary>
    private async Task DeleteTeamAsync(TeamViewModel team)
    {
        var members = team.MemberCount == 1 ? "1 member" : $"{team.MemberCount} members";
        var confirmed = await DialogService.Confirm(
            $"Team '{team.Name}' and its {members} will be permanently deleted. This cannot be undone.",
            "Delete team",
            new ConfirmOptions { OkButtonText = "Delete", CancelButtonText = "Cancel" });

        if (confirmed is not true) return;

        try
        {
            await TeamService.DeleteTeamAsync<TMember>(team.Key);

            if (_selectedTeam?.Key == team.Key) _selectedTeam = null;
            await LoadDataAsync();
            NotificationService.Notify(NotificationSeverity.Success, "Team deleted", team.Name);
        }
        catch (Exception ex)
        {
            NotificationService.Notify(NotificationSeverity.Error, "Delete failed", ex.Message);
        }
    }
}
